# Docker Compose reads .env. Keep this example free of real credentials.
POSTGRES_PASSWORD=
APP_PORT=3000
APP_URL=http://127.0.0.1:3000
# sandbox | live | simulator
PAYMENT_MODE=sandbox
ZARINPAL_SANDBOX_MERCHANT_ID=00000000-0000-4000-8000-000000000000
ZARINPAL_MERCHANT_ID=
# For Node.js outside Compose, set DATABASE_URL in .env.local.
# DATABASE_URL=postgresql://unishop:YOUR_PASSWORD@127.0.0.1:5432/unishop
# UNISHOP_DATA_DIR=./data